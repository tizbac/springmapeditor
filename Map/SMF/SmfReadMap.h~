class fakevfs
{
public:
	int cseek;
	int fsize;
string cpath;
	FILE * f;
	int Read(void * dest,int size){
	if (!this->f)
		{
		printf("Invalid file handler\n");
		return 1;}
	//printf("Read(dest,%i);\n",size);
	fread(dest,size,1,this->f);
	this->cseek = this->cseek + size;
	fseek(this->f,this->cseek,SEEK_SET);


}
	int Seek(int pos){
	//printf("Seek(%i);\n",pos);
	if (!this->f)
		{
		printf("Invalid file handler\n");
		return 1;
		}
	fseek(this->f,0,SEEK_END);
	//printf("Seek(%i);\n",pos);
	this->fsize = ftell(this->f);
	if ( pos > this->fsize )
	{
		printf("Invalid seek %i , size is %i\n",pos,this->fsize);
		return 1;
}


	
	this->cseek = pos;
	fseek(this->f,this->cseek,SEEK_SET);

}
	int Close(void){
	//printf("Closing file\n");
	fclose(this->f);
}
	int GetPos(void){return cseek;}





};
